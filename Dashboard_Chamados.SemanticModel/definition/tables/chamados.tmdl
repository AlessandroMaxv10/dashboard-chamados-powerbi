table chamados
	lineageTag: a1799ffd-aa37-4c1a-8517-96d34788d65f

	measure 'Total de Chamados' = COUNTROWS(chamados)
		formatString: #,0
		lineageTag: b9f6149c-df5e-4763-8628-2551258d1fd3

	measure 'Chamados Encerrados' = CALCULATE([Total de Chamados], chamados[status] = "Encerrado")
		formatString: #,0
		lineageTag: 5b22f1c9-127c-493d-957e-cb6d28771d9d

	measure '% SLA Cumprido' = DIVIDE(CALCULATE([Total de Chamados], chamados[cumpriu_sla] = "Sim"), CALCULATE([Total de Chamados], NOT ISBLANK(chamados[cumpriu_sla])))
		formatString: 0.0%
		lineageTag: b14376ac-8242-4ca2-b2bd-22ea98d378e5

	measure 'Tempo Médio de Reparo (h)' = AVERAGE(chamados[tempo_reparo_h])
		formatString: #,0.0
		lineageTag: 77c8935b-54e3-4fb4-a646-320cedfd5da6

	measure 'Tempo Médio Total (h)' = AVERAGE(chamados[tempo_total_h])
		formatString: #,0.0
		lineageTag: 1797b441-fb19-4428-b3b5-e859bbd05989

	measure 'Chamados Críticos' = CALCULATE([Total de Chamados], chamados[prioridade] = "Crítica")
		formatString: #,0
		lineageTag: afde4737-7321-4966-be60-a1be1c7c749e

	measure 'Falhas de Equipamento' = CALCULATE([Total de Chamados], chamados[tipo_falha] = "Falha de equipamento")
		formatString: #,0
		lineageTag: ef4d9e27-f16d-4e9a-ba82-454711990c9a

	measure 'Furtos e Vandalismo' = CALCULATE([Total de Chamados], chamados[tipo_falha] = "Furto/vandalismo de cabo")
		formatString: #,0
		lineageTag: 4107d89a-8c01-454d-904a-45608204946e

	measure 'Rompimentos por Mês' = DIVIDE(CALCULATE([Total de Chamados], chamados[tipo_falha] = "Rompimento de fibra"), DISTINCTCOUNT(Calendario[MesOrdem]))
		formatString: #,0
		lineageTag: 7d4e2020-e290-43f0-8be0-1aed9f86aac8

	measure 'Tempo Reparo Rompimento (h)' = CALCULATE([Tempo Médio de Reparo (h)], chamados[tipo_falha] = "Rompimento de fibra")
		formatString: #,0.0
		lineageTag: 2a399373-1bbe-464b-99cb-d9ac5e80aee4

	column id_chamado
		dataType: int64
		lineageTag: acb77135-bc2d-40ba-a781-fb2d6ad1a262
		summarizeBy: sum
		sourceColumn: id_chamado

