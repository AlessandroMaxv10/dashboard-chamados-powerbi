	column turno
		dataType: string
		lineageTag: f2361885-e859-4c64-9333-ad7c941b1b78
		summarizeBy: none
		sourceColumn: turno

	partition chamados = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\Users\ALESSANDRO\Desktop\Projetos GitHub\dashboard-chamados-powerbi\csv\chamados.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Cabecalhos = Table.TransformColumnNames(Promovidos, each Text.Replace(_, "#(feff)", "")),
				    Vazios = Table.ReplaceValue(Cabecalhos, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalhos)),
				    Tipos = Table.TransformColumnTypes(Vazios, {{"id_chamado", Int64.Type}, {"abertura", type datetime}, {"inicio_atendimento", type datetime}, {"encerramento", type datetime}, {"id_cliente", Int64.Type}, {"id_pop", Int64.Type}, {"id_tecnico", Int64.Type}, {"tipo_falha", type text}, {"causa_raiz", type text}, {"prioridade", type text}, {"sla_horas", Int64.Type}, {"distancia_falha_km", type number}, {"perda_db", type number}, {"status", type text}}, "en-US"),
				    TipoCorrigido = Table.TransformColumns(Tipos, {{"tipo_falha", each Text.Upper(Text.Start(_, 1)) & Text.Lower(Text.Middle(_, 1)), type text}}),
				    CausaVazia = Table.ReplaceValue(TipoCorrigido, null, "Não informada", Replacer.ReplaceValue, {"causa_raiz"}),
				    DataAbertura = Table.AddColumn(CausaVazia, "data_abertura", each DateTime.Date([abertura]), type date),
				    TempoTotal = Table.AddColumn(DataAbertura, "tempo_total_h", each if [encerramento] = null then null else Duration.TotalHours([encerramento] - [abertura]), type number),
				    TempoReparo = Table.AddColumn(TempoTotal, "tempo_reparo_h", each if [encerramento] = null then null else Duration.TotalHours([encerramento] - [inicio_atendimento]), type number),
				    Sla = Table.AddColumn(TempoReparo, "cumpriu_sla", each if [tempo_total_h] = null then null else if [tempo_total_h] <= [sla_horas] then "Sim" else "Não", type text),
				    Turno = Table.AddColumn(Sla, "turno", each if Time.Hour([abertura]) >= 22 or Time.Hour([abertura]) < 5 then "Noite" else "Dia", type text)
				in
				    Turno

